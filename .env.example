# Single source of local configuration for every app and package in this repo.
# Copy to `.env` at the repo root and fill it in. `.env` is gitignored; never commit it.
#
#   cp .env.example .env
#
# Who reads it:
#   apps/cli        `node --env-file-if-exists=../../.env` in its `mday` task
#   apps/api        `wrangler dev --env-file ../../.env`
#   apps/scheduler  `wrangler dev --env-file ../../.env`
#   packages/db     `process.loadEnvFile` in drizzle.config.ts
#
# In CI and on deployed Workers there is no `.env`: values come from GitHub secrets and
# Wrangler vars/secrets instead. An already-set variable always wins over this file.
#
# `wrangler dev` binds every variable below into the Worker, so the API sees the CLI's and the
# scheduler's too. Each app's Zod config ignores what it doesn't declare.

# --- Database -------------------------------------------------------------------------------
# Neon Postgres connection string. Use the POOLED host (the `-pooler` endpoint) so many
# short-lived isolate connections don't exhaust Postgres, and append `?sslmode=require` (Neon
# only accepts TLS). Reached from Workers via the serverless driver, never raw pg TCP.
#
# WARNING: there is no separate dev database — this points at PRODUCTION (`matchday`). Every
# local command that writes, writes live data. Prefer `--dry-run` while iterating, and treat
# `mday client` commands as production changes. Don't run migrations locally; they run in CI
# from the DATABASE_URL secret on push to main.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Shared ---------------------------------------------------------------------------------
# Log level: debug | info | warn | error (optional, default: info).
LOG_LEVEL=info

# Environment tag: development | production (optional, default: development). The deployed
# Workers commit "production" in their wrangler.jsonc; keep this "development" locally so dev
# traffic isn't tagged as production in Sentry.
ENVIRONMENT=development

# --- apps/api -------------------------------------------------------------------------------
# Sentry DSN (optional; unset disables error/trace reporting, which is fine for local dev).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- apps/cli -------------------------------------------------------------------------------
# playwright-core browser endpoint (optional).
# Unset -> launch local Chrome (thanos primary).
# Set   -> connect to a managed browser (fallback), e.g. ws://browser:3000
# BROWSER_WS_ENDPOINT=ws://localhost:3000

# Cloudflare R2 — mirroring club logos. Required even for a dry run: raw responses are staged
# to R2 before any transform.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=matchday-logos

# Public base URL mirrored club logos are served from (a custom domain or R2.dev subdomain bound
# to R2_BUCKET_NAME) — distinct from the private S3-compatible endpoint used to write objects.
R2_PUBLIC_ASSETS_URL=https://assets.matchday.dev

# Cloudflare R2 — staging raw Dribl API responses pre-transform. This bucket should have a 7-day
# lifecycle expiry rule; it is separate from the permanent logos bucket above.
R2_RAW_BUCKET_NAME=matchday-raw

# --- apps/scheduler -------------------------------------------------------------------------
# Fine-grained GitHub PAT used to fire workflow_dispatch. Scope it to this repository only, with
# Repository permissions -> Actions: Read and write. Nothing else.
#
# In CI this comes from the GH_DISPATCH_TOKEN repository secret, not GITHUB_TOKEN — Actions
# reserves that name for its own built-in token and refuses a repository secret using it.
#
# Fine-grained tokens expire (1 year maximum). When it does, dispatches start failing with
# HTTP 401 and the Worker logs `scheduler.dispatchfailed` — check Workers Logs if crawls stop.
GITHUB_TOKEN=github_pat_xxx

# Repository the crawl workflows live in.
GITHUB_OWNER=dejanvasic85
GITHUB_REPO=matchday

# Branch to dispatch from. GitHub only accepts a ref that holds the workflow file (optional,
# default: main).
GITHUB_REF=main
