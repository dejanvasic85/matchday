# Local config for every app and package. Copy to `.env` at the repo root (gitignored).
# In CI and on deployed Workers the values come from secrets instead; an already-set
# variable always wins over this file.

# Neon Postgres, POOLED host (`-pooler`), `?sslmode=require`.
#
# WARNING: this points at PRODUCTION — there is no dev database. Every local command that
# writes, writes live data. Prefer `--dry-run`. Don't run migrations locally.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# debug | info | warn | error (optional, default: info).
LOG_LEVEL=info

# development | production (optional, default: development). Keep it development locally so
# dev traffic isn't tagged as production in Sentry.
ENVIRONMENT=development

# apps/api. Optional — unset disables Sentry reporting.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# apps/cli. Optional: unset launches local Chrome, set connects to a managed browser.
# BROWSER_WS_ENDPOINT=ws://localhost:3000

# apps/cli. Cloudflare R2 — required even for a dry run, which still stages raw responses.
# R2_PUBLIC_ASSETS_URL is where logos are served from; the rest write to the buckets.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=matchday-logos
R2_PUBLIC_ASSETS_URL=https://assets.matchday.dev
R2_RAW_BUCKET_NAME=matchday-raw

# apps/scheduler. Fine-grained PAT, this repo only, Actions: Read and write. Expires within a
# year; dispatches then fail with HTTP 401 and the Worker logs `scheduler.dispatchfailed`.
# CI passes it from the GH_DISPATCH_TOKEN secret — Actions reserves the GITHUB_TOKEN name.
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=dejanvasic85
GITHUB_REPO=matchday
# Optional, default: main. GitHub only accepts a ref that holds the workflow file.
GITHUB_REF=main
