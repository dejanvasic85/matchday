# apps/api environment — validated by src/config.ts (Zod).
# On Cloudflare Workers these are Wrangler secrets/vars, not a .env file.

# Neon Postgres connection string (serverless driver / Hyperdrive). Use the POOLED host (the
# `-pooler` endpoint) so many short-lived isolate connections don't exhaust Postgres, and append
# `?sslmode=require` (Neon only accepts TLS). Migrations use the direct host instead (see packages/db).
#
# WARNING: there is no separate dev database — local `.dev.vars` points at PRODUCTION (`matchday`).
# `vp dev` against this is reading and writing live data.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Comma-separated allowed CORS origins (optional; empty = same-origin only).
ALLOWED_ORIGINS=https://williamstownsc.com

# Log level: debug | info | warn | error (optional, default: info).
LOG_LEVEL=info

# Sentry DSN (optional; unset disables error/trace reporting, e.g. for local dev).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment tag: development | production (optional, default: development).
# wrangler.jsonc commits "production" for the deployed Worker; override in a local .dev.vars.
ENVIRONMENT=development
