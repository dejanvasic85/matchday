# apps/scheduler environment — validated by src/config.ts (Zod).
# On Cloudflare Workers these are Wrangler secrets/vars, not a .env file. Non-secret values are
# committed in wrangler.jsonc; only GITHUB_TOKEN is a secret.

# Fine-grained GitHub PAT used to fire workflow_dispatch. Scope it to this repository only, with
# Repository permissions -> Actions: Read and write. Nothing else.
#
# In CI this comes from the GH_DISPATCH_TOKEN repository secret, not GITHUB_TOKEN — Actions
# reserves that name for its own built-in token and refuses a repository secret using it.
#
# Fine-grained tokens expire (1 year maximum). When it does, dispatches start failing with
# HTTP 401 and the Worker logs `scheduler.dispatchfailed` — check Workers Logs if crawls stop.
GITHUB_TOKEN=github_pat_xxx

# Repository the workflows live in.
GITHUB_OWNER=dejanvasic85
GITHUB_REPO=matchday

# Branch to dispatch from. GitHub only accepts a ref that holds the workflow file (optional,
# default: main).
GITHUB_REF=main

# Log level: debug | info | warn | error (optional, default: info). Set to debug to log the
# hourly ticks that fall outside a game window.
LOG_LEVEL=info

# Environment tag: development | production (optional, default: development).
ENVIRONMENT=development
