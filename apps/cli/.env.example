# apps/scraper environment — validated by src/config.ts (Zod).

# Neon Postgres connection string (scraper upserts by external_ref). Use the POOLED host (the
# `-pooler` endpoint) and append `?sslmode=require` (Neon only accepts TLS). Migrations use the
# direct host instead (see packages/db).
#
# WARNING: there is no separate dev database — this points at PRODUCTION (`matchday`). Every crawl
# and client command writes live data; prefer --dry-run while iterating.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# playwright-core browser endpoint (optional).
# Unset -> launch local Chrome (thanos primary).
# Set   -> connect to a managed browser (fallback), e.g. ws://browser:3000
# BROWSER_WS_ENDPOINT=ws://localhost:3000

# Cloudflare R2 — mirroring club logos.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=matchday-logos

# Public base URL mirrored club logos are served from (a custom domain or R2.dev subdomain bound
# to R2_BUCKET_NAME) — distinct from the private S3-compatible endpoint used to write objects.
R2_PUBLIC_ASSETS_URL=https://assets.matchday.dev

# Cloudflare R2 — staging raw Dribl API responses pre-transform. Bucket should have a 7-day
# lifecycle expiry rule configured (0004); separate from the permanent logos bucket above.
R2_RAW_BUCKET_NAME=matchday-raw

# Log level: debug | info | warn | error (optional, default: info).
LOG_LEVEL=info
