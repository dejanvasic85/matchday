{
  "name": "matchday-sdk",
  "version": "2.4.0",
  "private": false,
  "description": "A typed client for the matchday API, generated from its live OpenAPI spec.",
  "keywords": [
    "dribl",
    "fixtures",
    "matchday",
    "openapi",
    "sdk",
    "sports"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dejanvasic85/matchday.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generateClient.ts",
    "build": "node scripts/generateClient.ts && vp pack",
    "test": "node scripts/generateClient.ts && vp test run",
    "check": "node scripts/generateClient.ts && vp check"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@matchday/api": "workspace:*",
    "@types/node": "catalog:",
    "openapi-typescript": "7.13.0",
    "typescript": "catalog:",
    "vite-plus": "0.3.0"
  }
}
