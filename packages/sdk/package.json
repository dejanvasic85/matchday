    "check": "node scripts/generateClient.ts && vp check"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@matchday/api": "workspace:*",
    "@types/node": "catalog:",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite-plus": "0.2.8"
  }
