{
  "name": "@dejanvasic85/matchday-sdk",
  "version": "0.0.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "node scripts/generateClient.ts",
