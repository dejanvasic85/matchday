# Neon Postgres connection string for drizzle-kit migrations / studio. Copy to `.env.local`
# (gitignored) and point it at your DEV database. Use the DIRECT host (no `-pooler`) since a
# migration is one long-lived connection doing DDL, and append `?sslmode=require` (Neon needs TLS).
# The apps use the pooled host at runtime (see apps/*/.env.example). Prod migrations run only in
# CI from the DATABASE_URL secret.
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
