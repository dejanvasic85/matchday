# Neon Postgres connection string (pooled). Copy to `.env.local` (gitignored) for local
# drizzle-kit migrations and studio (`vp run db:migrate` / `db:studio`); point it at your DEV
# database. Prod migrations run only in CI from the DATABASE_URL secret. Reached from Workers
# via the serverless (neon-http) driver, never raw pg TCP.
DATABASE_URL=postgres://user:password@host/dbname
