# Neon Postgres connection string for drizzle-kit migrations / studio. Copy to `.env.local`
# (gitignored). Use the DIRECT host (no `-pooler`) since a migration is one long-lived connection
# doing DDL, and append `?sslmode=require` (Neon needs TLS). The apps use the pooled host at
# runtime (see apps/*/.env.example).
#
# WARNING: there is no separate dev database — this points at PRODUCTION (`matchday`). Don't run
# migrations locally; they run in CI from the DATABASE_URL secret on push to main. Use this for
# read-only inspection (drizzle studio) unless you intend to change prod.
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
