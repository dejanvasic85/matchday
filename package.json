{
  "name": "matchday",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mday": "vp run --filter @matchday/cli mday",
    "changeset": "changeset",
    "version:sdk": "changeset version && pnpm --filter @dejanvasic85/matchday-sdk run generate && vp check --fix",
    "release:sdk": "pnpm --filter @dejanvasic85/matchday-sdk run build && pnpm changeset publish",
    "test": "vp run -r test",
    "ready": "vp check && vp run -r test && vp run -r build",
    "fallow": "fallow"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "fallow": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.24.0"
}
